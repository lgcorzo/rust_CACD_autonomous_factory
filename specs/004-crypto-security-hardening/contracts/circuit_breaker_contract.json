{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CircuitBreakerEvaluationContract",
  "description": "Schema for CircuitBreakerGuard evaluations, deadlock detection, and escalation alerts in Dark Gravity",
  "type": "object",
  "properties": {
    "evaluation_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["Passed", "Retrying", "AgentStuck"]
    },
    "current_attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "max_attempts": {
      "type": "integer",
      "default": 3
    },
    "sast_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 10.0
    },
    "diff_hash": {
      "type": "string",
      "description": "SHA-256 hash of the evaluated patch diff"
    },
    "is_deadlock": {
      "type": "boolean",
      "description": "True if consecutive attempts generated identical diff hashes"
    },
    "spend_velocity_alert": {
      "type": "boolean",
      "description": "True if consumption rate exceeded $1.00 / 60s"
    },
    "escalation_reason": {
      "type": ["string", "null"]
    }
  },
  "required": ["evaluation_id", "timestamp", "status", "current_attempt", "sast_score", "diff_hash"]
}
