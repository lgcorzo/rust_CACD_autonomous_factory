{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitlabVerificationReport",
  "description": "Schema for Dark Gravity GitLab Communication End-to-End Verification Reports",
  "type": "object",
  "required": [
    "timestamp",
    "gitlab_url",
    "target_projects",
    "overall_status",
    "checks",
    "execution_duration_ms"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "gitlab_url": {
      "type": "string",
      "format": "uri"
    },
    "target_projects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "overall_status": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "PARTIAL"]
    },
    "execution_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_name",
          "target",
          "status",
          "latency_ms",
          "message"
        ],
        "properties": {
          "check_name": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["Success", "Warning", "Failure", "Skipped"]
          },
          "latency_ms": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "remediation_hint": {
            "type": ["string", "null"]
          }
        }
      }
    }
  }
}
