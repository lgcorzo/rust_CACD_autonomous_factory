# Pipeline Remediation Environment Variables
# Copy to .env or inject into Kubernetes Deployment/DaemonSet

# Maximum concurrent remediation missions (default: 3)
MAX_CONCURRENT_REMEDIATIONS=3

# Polling interval in seconds between failure checks (default: 30)
PIPELINE_POLL_INTERVAL_SECS=30

# Self-referential safety guard repo (default: lgcorzo/rust_CACD_autonomous_factory)
SELF_REPO_GUARD=lgcorzo/rust_CACD_autonomous_factory

# Target repositories to poll for pipeline failures
GITHUB_REPOS=lgcorzo/rust_CACD_autonomous_factory
GITLAB_PROJECTS=lgcorzo/lince-rs,lgcorzo-lab/autonomous_factory,lgcorzo/fastapi-autogen-team

# API tokens for platform interactions
GITHUB_API_TOKEN=ghp_exampleToken1234567890
GITLAB_API_TOKEN=glpat_exampleToken1234567890
GITLAB_URL=https://gitlab.com

# Kafka broker connection
KAFKA_BROKERS=localhost:9092
